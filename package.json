{
  "name": "automitti",
  "version": "0.1.0",
  "stage": "preview",
  "private": true,
  "type": "module",
  "description": "Puts Mitti on any switcher: an emulated ATEM, NDI tally, HyperDeck and OSC rules, OSC feedback to many destinations, and a clip-time display page.",
  "license": "MIT",
  "bin": {
    "automitti": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "sim": "node drivers/players/mitti/sim.mjs",
    "test": "node --test --test-force-exit --test-timeout=20000 test/*.test.js",
    "sim:v160hd": "node drivers/switchers/v160hd/sim.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "koffi": "^3.3.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "atem-connection": "^3.10.2"
  }
}
